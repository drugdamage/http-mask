  "main": [
    {
      "id": "A01",
      "group": "authorization",
      "eol": "CRLF",
      "input": [
        "GET /case/a01 HTTP/1.1",
        "Host: example.test",
        "Authorization: Basic ZmljdGlvbi1hMDE6ZXhhbXBsZS1vbmx5LWEwMQ==",
        "X-Trace: case-a01",
        ""
      ],
      "expected": {
        "remove": ["GET /case/a01 HTTP/1.1", "Host: example.test", "X-Trace: case-a01", ""],
        "mask": ["GET /case/a01 HTTP/1.1", "Host: example.test", "Authorization: Basic MASKED", "X-Trace: case-a01", ""]
      },
      "annotations": [
        {"header": "Authorization", "occurrence": 1, "secrets": [[1, "ZmljdGlvbi1hMDE6ZXhhbXBsZS1vbmx5LWEwMQ=="]], "scheme": "Basic"}
      ]
    },
